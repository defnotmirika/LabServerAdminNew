<Window x:Class="LabServerAdmin.ExportAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Attendance Logs" 
        Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#CCCCCC" BorderThickness="2" CornerRadius="10" Background="White" Margin="20">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="📤 Export Attendance Logs" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center"
                          Foreground="#2C3E50"/>
                <TextBlock Text="Select date range to export" 
                          FontSize="12" 
                          HorizontalAlignment="Center"
                          Foreground="#7F8C8D"
                          Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Date Selection Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="From Date:" 
                              FontWeight="SemiBold" 
                              FontSize="14"
                              Foreground="#34495E"
                              VerticalAlignment="Center"
                              Width="100"/>
                    <DatePicker x:Name="StartDatePicker" 
                              Width="300"
                              SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="To Date:" 
                              FontWeight="SemiBold" 
                              FontSize="14"
                              Foreground="#34495E"
                              VerticalAlignment="Center"
                              Width="100"/>
                    <DatePicker x:Name="EndDatePicker" 
                              Width="300"
                              SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="TodayButton" 
                           Content="Today" 
                           Click="TodayButton_Click"
                           Background="#3498DB"
                           Foreground="White"
                           FontWeight="Bold"
                           Width="100"
                           Margin="0,0,10,0"/>
                    <Button x:Name="ThisWeekButton" 
                           Content="This Week" 
                           Click="ThisWeekButton_Click"
                           Background="#3498DB"
                           Foreground="White"
                           FontWeight="Bold"
                           Width="100"
                           Margin="0,0,10,0"/>
                    <Button x:Name="ThisMonthButton" 
                           Content="This Month" 
                           Click="ThisMonthButton_Click"
                           Background="#3498DB"
                           Foreground="White"
                           FontWeight="Bold"
                           Width="100"/>
                </StackPanel>

                <TextBlock x:Name="ErrorTextBlock" 
                          Text="" 
                          Foreground="Red" 
                          FontSize="12"
                          TextWrapping="Wrap"
                          Margin="0,15,0,0"
                          Visibility="Collapsed"/>
            </StackPanel>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" 
                       Content="Cancel" 
                       Click="CancelButton_Click"
                       Background="#95A5A6"
                       Foreground="White"
                       FontWeight="Bold"/>
                <Button x:Name="ExportButton" 
                       Content="Export" 
                       Click="ExportButton_Click"
                       Background="#27AE60"
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

