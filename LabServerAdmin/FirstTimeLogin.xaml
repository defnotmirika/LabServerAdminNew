<Window x:Class="LabServerAdmin.FirstTimeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First Time Login"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F5F5F5"
        AllowsTransparency="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#033a80">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="First time login" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                <TextBlock Text="Set a new password to continue." FontSize="16" Foreground="#b3c9e6" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="400"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="White">
            <Border Width="420"
                    Padding="30"
                    CornerRadius="10"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Set Password"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"/>
                         <TextBlock Text="Please enter a new password for your instructor account."
                                   FontSize="14"
                                   Foreground="#7F8C8D"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="New Password"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#34495E"
                                   Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedTextBox}" Margin="0,0,0,15">
                            <PasswordBox x:Name="NewPasswordBox"
                                         Height="40"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="10,8"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Confirm Password"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#34495E"
                                   Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedTextBox}" Margin="0,0,0,15">
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Height="40"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="10,8"
                                         VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="ErrorText"
                                   Text=""
                                   Foreground="Red"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed"/>

                        <Button Content="Save Password"
                                Click="Save_Click"
                                Background="#050d60"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="40"
                                Margin="0,10,0,0"/>
                        <Button Content="Cancel"
                                Click="Cancel_Click"
                                Background="#dc3545"
                                Foreground="White"
                                FontWeight="Bold"
                                Height="40"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>