<Window x:Class="LabServerAdmin.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Password"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F5F5F5"
        AllowsTransparency="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#033a80">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Forgot Password" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" Margin="0,0,0,15" TextWrapping="Wrap" LineHeight="50"/>
                <TextBlock Text="Send your username and reason for account help." FontSize="16" Foreground="#b3c9e6" HorizontalAlignment="Left" TextWrapping="Wrap" MaxWidth="400"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="White">
            <Border Width="420"
                    Padding="30"
                    CornerRadius="10"
                    Background="White"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Forgot Password" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Enter your username and the reason for your request."
                                   FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Username" FontWeight="SemiBold" FontSize="14" Foreground="#34495E" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedTextBox}" Margin="0,0,0,15">
                            <TextBox x:Name="UsernameTextBox" Height="40" BorderThickness="0" Background="Transparent" Padding="10,8" VerticalContentAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Reason / Feedback" FontWeight="SemiBold" FontSize="14" Foreground="#34495E" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedTextBox}" Margin="0,0,0,15">
                            <TextBox x:Name="FeedbackTextBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="10,8"/>
                        </Border>

                        <TextBlock x:Name="ErrorTextBlock" Text="" Foreground="Red" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                        <Button Content="Send Feedback" Click="SendFeedbackButton_Click" Background="#050d60" Foreground="White" FontWeight="Bold" Height="40" Margin="0,10,0,0"/>
                        <Button Content="Cancel" Click="CancelButton_Click" Background="#dc3545" Foreground="White" FontWeight="Bold" Height="40" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>