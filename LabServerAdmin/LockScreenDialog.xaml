<Window x:Class="LabServerAdmin.LockScreenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Locked - Lab Management System" 
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        Background="#050d60"
        ShowInTaskbar="False"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="UnlockButton" TargetType="Button">
            <Setter Property="Background" Value="#f8b800"/>
            <Setter Property="Foreground" Value="#050d60"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc61a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0a500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Lock Icon and Message -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Lock Icon -->
            <Viewbox Width="100" Height="100" Margin="0,0,0,30">
                <Canvas Width="24" Height="24">
                    <Path Fill="#f8b800" Data="M12,17C10.89,17 10,16.1 10,15C10,13.89 10.89,13 12,13A2,2 0 0,1 14,15A2,2 0 0,1 12,17M18,20V10H6V20H18M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V10C4,8.89 4.89,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"/>
                </Canvas>
            </Viewbox>

            <!-- Title -->
            <TextBlock Text="Screen Locked" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#f8b800" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Username Display -->
            <TextBlock x:Name="UsernameTextBlock"
                       Text="Instructor: [Username]" 
                       FontSize="18" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Lock Time Display -->
            <TextBlock x:Name="LockTimeTextBlock"
                       Text="Locked at: HH:mm:ss" 
                       FontSize="14" 
                       Foreground="#cccccc" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Instructions -->
            <TextBlock Text="Screen locked due to inactivity" 
                       FontSize="16" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Enter your password to unlock" 
                       FontSize="14" 
                       Foreground="#cccccc" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Password Input -->
            <Border Background="White" 
                    CornerRadius="5" 
                    Padding="15,10"
                    Width="350"
                    Margin="0,0,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Password Icon -->
                    <TextBlock Grid.Column="0" 
                               Text="Key Icon" 
                               FontSize="20" 
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <!-- Password Box -->
                    <PasswordBox x:Name="PasswordBox" 
                                 Grid.Column="1"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 PasswordChar="?"
                                 KeyDown="PasswordBox_KeyDown"/>
                </Grid>
            </Border>

            <!-- Error Message -->
            <TextBlock x:Name="ErrorTextBlock"
                       Text=""
                       FontSize="14" 
                       Foreground="#ff6b6b" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Visibility="Collapsed"
                       FontWeight="SemiBold"/>

            <!-- Unlock Button -->
            <Button x:Name="UnlockButton" 
                    Content="Unlock" 
                    Style="{StaticResource UnlockButton}"
                    Click="UnlockButton_Click"
                    Width="200"
                    Height="50"/>

            <!-- Additional Info -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,30,0,0">
                <TextBlock Text="Tip: Press " 
                           FontSize="12" 
                           Foreground="#999999"/>
                <TextBlock Text="Enter" 
                           FontSize="12" 
                           Foreground="#f8b800"
                           FontWeight="Bold"/>
                <TextBlock Text=" to unlock" 
                           FontSize="12" 
                           Foreground="#999999"/>
            </StackPanel>

            <!-- Logout Option -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,0">
                <TextBlock Text="Not you? " 
                           FontSize="12" 
                           Foreground="#999999"/>
                <TextBlock Text="Logout" 
                           FontSize="12" 
                           Foreground="#f8b800"
                           FontWeight="Bold"
                           Cursor="Hand"
                           MouseLeftButtonDown="LogoutLink_Click"
                           TextDecorations="Underline"/>
            </StackPanel>
        </StackPanel>

        <!-- Clock Display (Bottom Right) -->
        <StackPanel Grid.Row="2" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Right"
                    Margin="30">
            <TextBlock x:Name="ClockTextBlock"
                       Text="00:00:00"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Right"/>
            <TextBlock x:Name="DateTextBlock"
                       Text="Monday, January 1, 2024"
                       FontSize="16"
                       Foreground="#cccccc"
                       HorizontalAlignment="Right"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
