<Window x:Class="LabServerAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Server Admin - Login"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F5F5F5">



    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">

        <!-- Centered Login Card -->
        <Border Width="400"
            Padding="30"
            CornerRadius="10"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">

                    <!-- Two Images -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image Source="/Images/trinity.png" Width="50" Height="50" Margin="5"/>
                        <Image Source="/Images/learniq.png" Width="50" Height="50" Margin="5"/>
                    </StackPanel>

                    <TextBlock Text="Log In" 
                            FontSize="28" 
                            FontWeight="Bold" 
                            HorizontalAlignment="Center"
                            Foreground="#2C3E50"/>

                    <TextBlock Text="Please login to continue" 
                            FontSize="14" 
                            HorizontalAlignment="Center"
                            Foreground="#7F8C8D"
                            Margin="0,5,0,0"/>
                </StackPanel>


                <!-- Login Form -->
                <StackPanel Grid.Row="1">

                    <!-- Username -->
                    <TextBlock Text="Username" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Foreground="#34495E"/>

                    <TextBox x:Name="UsernameTextBox"
                         Height="40"
                         KeyDown="UsernameTextBox_KeyDown"/>

                    <!-- Password -->
                    <TextBlock Text="Password" 
                           FontWeight="SemiBold" 
                           FontSize="14"
                           Foreground="#34495E"/>

                    <PasswordBox x:Name="PasswordBox" 
                             Height="40"
                             KeyDown="PasswordBox_KeyDown"/>

                    <!-- Error Message -->
                    <TextBlock x:Name="ErrorTextBlock" 
                           Text="" 
                           Foreground="Red" 
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="Collapsed"/>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton" 
                        Content="Login" 
                        Click="LoginButton_Click"
                        Background="#3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

