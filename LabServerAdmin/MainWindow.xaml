                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" SortMemberPath="Timestamp">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Student No" Binding="{Binding StudNo}" Width="120" SortMemberPath="StudNo">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}" Width="150" SortMemberPath="StudentName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PC Name" Binding="{Binding PcName}" Width="120" SortMemberPath="PcName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" SortMemberPath="Action">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="2" BorderBrush="#050d60" BorderThickness="0,2,0,0" Padding="8" Background="#F5F5F5" Margin="0,8,0,0">
                        <StackPanel x:Name="ActivityPaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ActivityFirstButton" Content="First"
                                    Style="{StaticResource ModernButton}"
                                    Click="ActivityFirstButton_Click"
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <Button x:Name="ActivityPrevButton" Content="◀️ Prev"
                                    Style="{StaticResource ModernButton}"
                                    Click="ActivityPrevButton_Click"
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <TextBlock x:Name="ActivityPageInfoText"
                                       Text="Page 1 of 1 (0 records)"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#050d60"
                                       VerticalAlignment="Center"
                                       Margin="12,0"/>
                            <Button x:Name="ActivityNextButton" Content="Next ▶️"
                                    Style="{StaticResource ModernButton}"
                                    Click="ActivityNextButton_Click"
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <Button x:Name="ActivityLastButton" Content="Last"
                                    Style="{StaticResource ModernButton}"
                                    Click="ActivityLastButton_Click"
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- System Logs Tab -->
            <TabItem Header="📋 System Logs">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,5,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="RefreshLogsButton" Content="🔄" ToolTip="Refresh Logs" Style="{StaticResource GoldButton}" 
                                    Click="RefreshLogsButton_Click" Width="40" Height="35" Padding="0"/>
                            <Button x:Name="ExportLogsButton" Content="📤 Export" ToolTip="Export System Logs" Style="{StaticResource ModernButton}" 
                                    Click="ExportLogsButton_Click"/>
                            <Button x:Name="FilterSystemLogsTodayButton" Content="📅 Today" Style="{StaticResource ModernButton}" 
                                    Click="FilterSystemLogsTodayButton_Click"/>
                            <Button x:Name="FilterSystemLogsAllButton" Content="📋 All Records" Style="{StaticResource ModernButton}" 
                                    Click="FilterSystemLogsAllButton_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filter by Date:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#050d60"/>
                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker x:Name="SystemLogsStartDatePicker" Width="120" Height="32" Margin="0,0,20,0" 
                                        SelectedDateChanged="SystemLogsDatePicker_SelectedDateChanged" VerticalContentAlignment="Center"/>
                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <DatePicker x:Name="SystemLogsEndDatePicker" Width="120" Height="32" Margin="0,0,20,0" 
                                        SelectedDateChanged="SystemLogsDatePicker_SelectedDateChanged" VerticalContentAlignment="Center"/>
                            <Button x:Name="ApplySystemLogsDateFilterButton" Content="Apply Filter" Style="{StaticResource GoldButton}" 
                                    Click="ApplySystemLogsDateFilterButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="SystemLogsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True"
                              CanUserSortColumns="True" RowHeight="30">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" SortMemberPath="Timestamp">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="User ID" Binding="{Binding UserIdString}" Width="100" SortMemberPath="UserIdString">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" SortMemberPath="Action">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="120" SortMemberPath="ClientName">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" SortMemberPath="Status">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="2" BorderBrush="#050d60" BorderThickness="0,2,0,0" Padding="8" Background="#F5F5F5" Margin="0,8,0,0">
                        <StackPanel x:Name="SystemLogsPaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="SystemLogsFirstButton" Content="First" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="SystemLogsFirstButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <Button x:Name="SystemLogsPrevButton" Content="◀️ Prev" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="SystemLogsPrevButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <TextBlock x:Name="SystemLogsPageInfoText" 
                                       Text="Page 1 of 1 (0 records)" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#050d60" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0"/>
                            <Button x:Name="SystemLogsNextButton" Content="Next ▶️" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="SystemLogsNextButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <Button x:Name="SystemLogsLastButton" Content="Last" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="SystemLogsLastButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ScreenMonitorTab" Header="🖥️ Screen Monitor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="RefreshScreensButton" Content="🔄 Refresh" 
                        Style="{StaticResource GoldButton}" 
                        Click="RefreshScreensButton_Click" Height="35"/>
                        <Button x:Name="StopAllStreamsButton" Content="⏹️ Stop All" 
                        Style="{StaticResource DangerButton}" 
                        Click="StopAllStreamsButton_Click" Height="35"/>
                        <TextBlock x:Name="ScreenMonitorStatusText" 
                           Text="0 screens active" 
                           FontSize="13" FontWeight="SemiBold" 
                           Foreground="#050d60" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Screen Feeds" BorderBrush="#050d60" BorderThickness="2">
                        <GroupBox.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14" Foreground="#050d60"/>
                            </DataTemplate>
                        </GroupBox.HeaderTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ScreensWrapPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#050d60">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontWeight="SemiBold"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="ServerUptimeText" Text="Uptime: --:--:--" Foreground="#f8b800" FontWeight="SemiBold" Margin="20,0,0,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" x:Name="VoiceRejectionStatusItem" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🚫 " FontSize="12" Foreground="#ff6b6b" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="VoiceRejectionText" Text="Unknown voice detected! Command blocked." Foreground="#ff6b6b" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ConnectedClientsText" Text="Connected Clients: 0" Foreground="#f8b800" FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
