<Window x:Class="LabServerAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabServerAdmin"
        mc:Ignorable="d"
        Title="Instructor Interface - Lab Management System" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Placeholder TextBox Style -->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#050d60"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <!-- Placeholder Text -->
                                <TextBlock x:Name="placeholder" 
                                           Text="Search..." 
                                           Foreground="Gray" 
                                           Padding="8,4"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <!-- Text Input -->
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Background="Transparent"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hide placeholder when focused -->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0a1580"/>
                                <Setter TargetName="placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- Show placeholder when text is empty -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Hide placeholder when text is not empty -->
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Button Styles -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#050d60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0a1580"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#030a40"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VoiceCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#dc3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#8b1c28"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="On">
                    <Setter Property="Background" Value="#1e7e34"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#155724"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="#f8b800"/>
            <Setter Property="Foreground" Value="#050d60"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffc61a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0a500"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#dc3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#c82333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#bd2130"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#28a745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e7e34"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoHoverButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0a500"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="BorderBrush" Value="#050d60"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#050d60" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎓 Instructor UI" FontSize="24" FontWeight="Bold" Foreground="#f8b800" VerticalAlignment="Center"/>
                    <Ellipse x:Name="ServerStatusIndicator" Width="16" Height="16" Fill="Red" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Ellipse.ToolTip>
                            <ToolTip x:Name="ServerStatusTooltip" Content="Server: Stopped"/>
                        </Ellipse.ToolTip>
                    </Ellipse>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ServerToggleButton" Content="▶️ Start Server" Style="{StaticResource SuccessButton}" Click="ServerToggleButton_Click" Margin="10,0,0,0"/>
                    <Button x:Name="VoiceToggleButton" Content="Voice: OFF" Style="{StaticResource VoiceCommandButtonStyle}" 
                            Tag="Off" Click="VoiceToggleButton_Click" Margin="10,0,0,0"
                            Width="130"/>
                    <Button x:Name="LearniqButton" Content="🕮 Learniq" Style="{StaticResource ModernButton}" 
                            BorderBrush="#808080" BorderThickness="2"
                            Click="LearniqButton_Click" Margin="10,0,40,0" ToolTip="Open Learniq Learning Tool"/>
                    <Button x:Name="LogoutButton" Content="➜]" Style="{StaticResource GoldButton}" Click="LogoutButton_Click" Margin="10,0,0,0"/>
                    <Button x:Name="SettingsButton" Content="🛠" Style="{StaticResource NoHoverButton}" 
                            Background="#f8b800" Foreground="#050d60"
                            Click="SettingsButton_Click" ToolTip="Configure screen lock settings" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="10" SelectionChanged="MainTabControl_SelectionChanged">
            <!-- Dashboard Tab -->
            <TabItem Header="📊 Dashboard" Height="22" Margin="-2,0,-2,0" VerticalAlignment="Bottom">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Client Controls -->
                    <GroupBox Grid.Row="0" Header="Client Controls" Margin="0,0,0,10" BorderBrush="#050d60" BorderThickness="2">
                        <GroupBox.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14" Foreground="#050d60"/>
                            </DataTemplate>
                        </GroupBox.HeaderTemplate>
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <Button x:Name="LockAllButton" Content="🔒 Lock All" Style="{StaticResource ModernButton}" Click="LockAllButton_Click"/>
                            <Button x:Name="UnlockAllButton" Content="🔓 Unlock All" Style="{StaticResource ModernButton}" Click="UnlockAllButton_Click"/>
                            <Button x:Name="ShutdownAllButton" Content="⏹️ Shutdown All" Style="{StaticResource DangerButton}" Click="ShutdownAllButton_Click"/>
                            <Button x:Name="RestartAllButton" Content="🔄 Restart All" Style="{StaticResource DangerButton}" Click="RestartAllButton_Click"/>
                            <Button x:Name="SleepAllButton" Content="😴 Sleep All" Style="{StaticResource ModernButton}" Click="SleepAllButton_Click"/>
                            <Button x:Name="RefreshClientsButton" Content="🔄" ToolTip="Refresh Clients" Style="{StaticResource GoldButton}" 
                                    Click="RefreshClientsButton_Click" Width="40" Height="35" Padding="0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Connected Clients -->
                    <GroupBox Grid.Row="1" Header="Connected Clients" BorderBrush="#050d60" BorderThickness="2">
                        <GroupBox.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14" Foreground="#050d60"/>
                            </DataTemplate>
                        </GroupBox.HeaderTemplate>
                        <DataGrid x:Name="ClientsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True" RowHeight="35">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PC Name" Binding="{Binding Name}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Last Response" Binding="{Binding LastResponse, StringFormat=HH:mm:ss}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Actions" Width="350" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="🔒" ToolTip="Lock" Style="{StaticResource ModernButton}" 
                                                        Click="LockClientButton_Click" Tag="{Binding Name}" Width="38" Height="28" Padding="3" Margin="2,0"/>
                                                <Button Content="🔓" ToolTip="Unlock" Style="{StaticResource ModernButton}" 
                                                        Click="UnlockClientButton_Click" Tag="{Binding Name}" Width="38" Height="28" Padding="3" Margin="2,0"/>
                                                <Button Content="⏹️" ToolTip="Shutdown" Style="{StaticResource DangerButton}" 
                                                        Click="ShutdownClientButton_Click" Tag="{Binding Name}" Width="38" Height="28" Padding="3" Margin="2,0"/>
                                                <Button Content="🔄" ToolTip="Restart" Style="{StaticResource DangerButton}" 
                                                        Click="RestartClientButton_Click" Tag="{Binding Name}" Width="38" Height="28" Padding="3" Margin="2,0"/>
                                                <Button Content="😴" ToolTip="Sleep" Style="{StaticResource ModernButton}" 
                                                        Click="SleepClientButton_Click" Tag="{Binding Name}" Width="38" Height="28" Padding="3" Margin="2,0"/>
                                                <Button Content="📋" ToolTip="View Logs" Style="{StaticResource GoldButton}" 
                                                        Click="ViewLogsButton_Click" Tag="{Binding Name}" Width="38" Height="28" Padding="3" Margin="2,0"/>
                                                <Button Content="🖥️" ToolTip="Remote View" Style="{StaticResource GoldButton}"
                                                        Click="ViewScreenButton_Click" Tag="{Binding Name}" Width="38" Height="28" Padding="3" Margin="2,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="2" BorderBrush="#050d60" BorderThickness="0,2,0,0" Padding="8" Background="#F5F5F5" Margin="0,8,0,0">
                        <StackPanel x:Name="ClientsPaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ClientsFirstButton" Content="First" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="ClientsFirstButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <Button x:Name="ClientsPrevButton" Content="◀️ Prev" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="ClientsPrevButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <TextBlock x:Name="ClientsPageInfoText" 
                                       Text="Page 1 of 1 (0 clients)" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#050d60" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0"/>
                            <Button x:Name="ClientsNextButton" Content="Next ▶️" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="ClientsNextButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <Button x:Name="ClientsLastButton" Content="Last" 
                                    Style="{StaticResource ModernButton}" 
                                    Click="ClientsLastButton_Click" 
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Requests Tab -->
            <TabItem Header="🔐 Requests">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="RefreshLoginRequestsButton" Content="🔄" ToolTip="Refresh Requests" Style="{StaticResource GoldButton}" 
                                Click="RefreshLoginRequestsButton_Click" Width="40" Height="35" Padding="0"/>
                        <TextBlock x:Name="PendingRequestsCountText" Text="Pending: 0" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#050d60" 
                                   VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>

                    <!-- Requests DataGrid -->
                    <DataGrid x:Name="LoginRequestsDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True" RowHeight="35">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Request Type -->
                            <DataGridTextColumn Header="Type" Binding="{Binding RequestType}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Student No -->
                            <DataGridTextColumn Header="Student No" Binding="{Binding StudNo}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- PC Name -->
                            <DataGridTextColumn Header="PC Name" Binding="{Binding PcName}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Request Time -->
                            <DataGridTextColumn Header="Request Time" Binding="{Binding RequestTimeFormatted}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status -->
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                <Setter Property="Foreground" Value="Orange"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Declined">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="Actions" Width="220" MinWidth="220" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Approve Button - Only visible for Pending requests -->
                                            <Button Content="✓ Approve" 
                                                    Style="{StaticResource SuccessButton}" 
                                                    Click="ApproveLoginRequestButton_Click" 
                                                    Tag="{Binding Id}" 
                                                    Width="100" Height="30" Padding="8,4"
                                                    Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Decline Button - Only visible for Pending requests -->
                                            <Button Content="✗ Decline" 
                                                    Style="{StaticResource DangerButton}" 
                                                    Click="DeclineLoginRequestButton_Click" 
                                                    Tag="{Binding Id}" 
                                                    Width="100" Height="30" Padding="8,4"
                                                    Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="2" BorderBrush="#050d60" BorderThickness="0,2,0,0" Padding="8" Background="#F5F5F5" Margin="0,8,0,0">
                        <StackPanel x:Name="LoginRequestsPaginationPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="LoginRequestsFirstButton" Content="First"
                                    Style="{StaticResource ModernButton}"
                                    Click="LoginRequestsFirstButton_Click"
                                    Width="75" Height="28" Padding="5,3" Margin="2"/>
                            <Button x:Name="LoginRequestsPrevButton" Content="◀️ Prev"
                                    Style="{StaticResource ModernButton}"
                                    Click="LoginRequestsPrevButton_Click"
