<Window x:Class="LabServerAdmin.MicTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabServerAdmin"
        mc:Ignorable="d"
        Title="MicTest"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#050d60">

    <Grid>

        <!-- Centered composition area -->
        <Canvas Width="520"
            Height="380"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <TextBlock x:Name="CardTutorialText"
       Canvas.Left="60"
       Canvas.Top="-30"
       Width="400"
       Text="Tutorial"
       FontWeight="Bold"
       FontSize="30"
       Foreground="White"
       TextAlignment="Center"/>

            <!-- Card -->
            <Border Canvas.Left="60"
                Canvas.Top="40"
                Width="400"
                Height="300"
                Background="White"
                CornerRadius="15"
                Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- WAVE VISUALIZER -->
                    <Border Grid.Row="0"
                        Background="WhiteSmoke"
                        CornerRadius="10"
                        Padding="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <Rectangle x:Name="Wave1" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave2" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave3" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave4" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave5" Width="10" Height="20" Fill="Green" Margin="5"/>

                        </StackPanel>

                    </Border>

                    <!-- CONTROLS -->
                    <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                        <!-- MIC BUTTON -->
                        <Grid HorizontalAlignment="Center">

                            <Ellipse x:Name="Glow"
                                 Width="120"
                                 Height="120"
                                 Fill="DeepSkyBlue"
                                 Opacity="0"/>

                            <Button x:Name="MicButton"
                                Width="80"
                                Height="80"
                                Click="MicButton_Click"
                                Background="#F8B800"
                                BorderBrush="White"
                                BorderThickness="2">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="{TemplateBinding Background}"
                                                 Stroke="{TemplateBinding BorderBrush}"
                                                 StrokeThickness="2"/>

                                            <TextBlock Text="🎙️"
                                                   FontSize="30"
                                                   Foreground="#050d60"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>

                            </Button>

                        </Grid>

                        <!-- DEVICE DROPDOWN -->
                        <ComboBox x:Name="DeviceList"
                              Width="250"
                              Height="30"
                              Margin="0,15,0,0"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              SelectionChanged="DeviceList_SelectionChanged">

                            <!-- Blue outline when focused -->
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="BorderBrush" Value="#FFBEBEBE"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsDropDownOpen" Value="True">
                                            <Setter Property="BorderBrush" Value="DeepSkyBlue"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="DeepSkyBlue"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>

                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>

                        </ComboBox>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- Tutorial Box outside the card -->
            <Border x:Name="TutorialBox"
                Canvas.Left="-180"
                Canvas.Top="40"
                Width="220"
                Height="140"
                Background="#FFFDE9A9"
                BorderBrush="#FFB8860B"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10"
                Opacity="1"
                Panel.ZIndex="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TutorialText"
                           Grid.Row="0"
                           Text="This is the voice button"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevButton"
                            Content="Previous"
                            Width="70"
                            Height="30"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="Prev_Click"/>

                        <Button x:Name="NextButton"
                            Content="Next"
                            Width="70"
                            Height="30"
                            HorizontalAlignment="Right"
                            Grid.Column="1"
                            Click="Next_Click"/>

                    </Grid>

                </Grid>

            </Border>

        </Canvas>

    </Grid>
</Window>
