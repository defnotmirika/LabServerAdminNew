<Window x:Class="LabServerAdmin.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Remote Control" Height="650" Width="950"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderText" Text="Client" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="StatusText" Text="Waiting for stream..." FontSize="14" Foreground="LightGray" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <ToggleButton x:Name="ControlToggleButton" Content="Enable Control" Width="140" Margin="20,0,0,0"
                          VerticalAlignment="Center" Checked="ControlToggleButton_Checked" Unchecked="ControlToggleButton_Unchecked"/>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Refresh:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="RefreshRateComboBox" Width="120" SelectionChanged="RefreshRateComboBox_SelectionChanged">
                    <ComboBoxItem Content="1 FPS" Tag="1000"/>
                    <ComboBoxItem Content="2 FPS" Tag="500"/>
                    <ComboBoxItem Content="5 FPS" Tag="200"/>
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="10" Background="Black" CornerRadius="4" BorderBrush="#2A2A2A" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Cross"
                       MouseMove="ScreenImage_MouseMove"
                       MouseLeftButtonDown="ScreenImage_MouseLeftButtonDown"
                       MouseLeftButtonUp="ScreenImage_MouseLeftButtonUp"
                       MouseRightButtonDown="ScreenImage_MouseRightButtonDown"
                       MouseRightButtonUp="ScreenImage_MouseRightButtonUp"
                       MouseWheel="ScreenImage_MouseWheel"
                       Margin="10"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

