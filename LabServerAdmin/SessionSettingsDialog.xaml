<Window x:Class="LabServerAdmin.SessionSettingsDialog"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Session Settings" Height="650" Width="600"
WindowStartupLocation="CenterOwner"
ResizeMode="CanResize"
MinHeight="500"
MinWidth="600"
Background="White">

<Window.Resources>
    <!-- Modern Button Style -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background" Value="#050d60"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0a1580"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#030a40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success Button Style -->
    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="Background" Value="#28a745"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#218838"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1e7e34"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Window.Resources>

<Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Scrollable Content Area -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,20,20,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="⚙️ Session Lock Configuration" 
                       FontSize="18" FontWeight="Bold" Foreground="#050d60" Margin="0,0,0,15"/>

            <!-- Description -->
            <TextBlock Grid.Row="1" Text="Configure automatic screen lock settings for security"
                       FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15"/>

            <!-- Admin Timeout -->
            <GroupBox Grid.Row="2" Header="Admin Screen Lock Timeout" BorderBrush="#050d60" BorderThickness="2" Padding="15" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Minutes until automatic screen lock:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBox x:Name="AdminTimeoutMinutesTextBox" Width="60" Height="32" Padding="8,4"
                                 BorderBrush="#050d60" BorderThickness="2" 
                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                 FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="minutes" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#050d60"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Range: 5-120 minutes (Default: 15)"
                               FontSize="11" Foreground="#999999" Margin="0,8,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Admin Warning Threshold -->
            <GroupBox Grid.Row="3" Header="Admin Warning Threshold" BorderBrush="#050d60" BorderThickness="2" Padding="15" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Show warning this many minutes before logout:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBox x:Name="AdminWarningMinutesTextBox" Width="60" Height="32" Padding="8,4"
                                 BorderBrush="#050d60" BorderThickness="2" 
                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                 FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="minutes" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#050d60"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Range: 1-10 minutes (Default: 1)"
                               FontSize="11" Foreground="#999999" Margin="0,8,0,0"/>
                </Grid>
            </GroupBox>

            <!-- Info Box -->
            <Border Grid.Row="4" Background="#E8F4F8" BorderBrush="#4A9BB4" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ℹ️ How It Works:" FontWeight="Bold" Foreground="#050d60" Margin="0,0,0,6"/>
                    <TextBlock Text="• System checks for activity every 30 seconds" FontSize="11" Foreground="#333333" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Warning appears when timeout - warning threshold is reached" FontSize="11" Foreground="#333333" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Click OK to reset timer or Cancel to lock immediately" FontSize="11" Foreground="#333333" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Screen locks if no activity - enter password to unlock" FontSize="11" Foreground="#333333" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Your session stays active in the background" FontSize="11" Foreground="#333333" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Preset Buttons -->
            <GroupBox Grid.Row="5" Header="Quick Presets" BorderBrush="#050d60" BorderThickness="2" Padding="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="HighSecurityButton" Content="🔒 High (5 min)" 
                            Style="{StaticResource ModernButton}" Click="HighSecurityButton_Click"
                            Width="135" Height="35" Padding="8,5" FontSize="13"/>
                    <Button x:Name="NormalButton" Content="⚖️ Normal (15 min)" 
                            Style="{StaticResource ModernButton}" Click="NormalButton_Click"
                            Width="150" Height="35" Padding="8,5" FontSize="13"/>
                    <Button x:Name="RelaxedButton" Content="😊 Relaxed (30 min)" 
                            Style="{StaticResource ModernButton}" Click="RelaxedButton_Click"
                            Width="160" Height="35" Padding="8,5" FontSize="13"/>
                </StackPanel>
            </GroupBox>

            <!-- Current Settings Display -->
            <Border Grid.Row="6" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="📊 Current Settings:" FontWeight="Bold" Foreground="#050d60" Margin="0,0,0,6"/>
                    <TextBlock x:Name="CurrentSettingsTextBlock" Text="Timeout: 15 min, Warning: 1 min" 
                               FontSize="12" Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

    <!-- Action Buttons (Fixed at bottom) -->
    <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Background="#F9F9F9" Padding="20,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="💾 Save" Width="110" Height="38" 
                        Style="{StaticResource SuccessButton}" Click="SaveButton_Click"/>
                <Button x:Name="CancelButton" Content="❌ Cancel" Width="110" Height="38" 
                        Style="{StaticResource ModernButton}" Click="CancelButton_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Border>
</Grid>
</Window>
