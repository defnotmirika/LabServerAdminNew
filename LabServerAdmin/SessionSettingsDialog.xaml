<Window x:Class="LabServerAdmin.SessionSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Settings" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="?? Session Lock Configuration" 
                   FontSize="18" FontWeight="Bold" Foreground="#050d60" Margin="0,0,0,20"/>

        <!-- Description -->
        <TextBlock Grid.Row="1" Text="Configure automatic screen lock settings for security"
                   FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,20"/>

        <!-- Admin Timeout -->
        <GroupBox Grid.Row="2" Header="Admin Screen Lock Timeout" BorderBrush="#050d60" BorderThickness="2" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Minutes until automatic screen lock:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBox x:Name="AdminTimeoutMinutesTextBox" Width="60" Height="35" Padding="8,4"
                             BorderBrush="#050d60" BorderThickness="2" 
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#050d60"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Range: 5-120 minutes (Default: 15)"
                           FontSize="11" Foreground="#999999" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Admin Warning Threshold -->
        <GroupBox Grid.Row="3" Header="Admin Warning Threshold" BorderBrush="#050d60" BorderThickness="2" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Show warning this many minutes before logout:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBox x:Name="AdminWarningMinutesTextBox" Width="60" Height="35" Padding="8,4"
                             BorderBrush="#050d60" BorderThickness="2" 
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#050d60"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Range: 1-10 minutes (Default: 1)"
                           FontSize="11" Foreground="#999999" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Info Box -->
        <Border Grid.Row="4" Background="#E8F4F8" BorderBrush="#4A9BB4" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Info - How It Works:" FontWeight="Bold" Foreground="#050d60" Margin="0,0,0,8"/>
                <TextBlock Text="System checks for activity every 30 seconds" FontSize="11" Foreground="#333333" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="Warning appears when timeout - warning threshold is reached" FontSize="11" Foreground="#333333" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="Click OK to reset timer or Cancel to lock immediately" FontSize="11" Foreground="#333333" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="Screen locks if no activity - enter password to unlock" FontSize="11" Foreground="#333333" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="Your session stays active in the background" FontSize="11" Foreground="#333333" FontWeight="Bold" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Preset Buttons -->
        <GroupBox Grid.Row="5" Header="Quick Presets" BorderBrush="#050d60" BorderThickness="2" Padding="15">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="HighSecurityButton" Content="?? High Security (5 min)" 
                        Style="{StaticResource ModernButton}" Click="HighSecurityButton_Click"/>
                <Button x:Name="NormalButton" Content="??? Normal (15 min)" 
                        Style="{StaticResource ModernButton}" Click="NormalButton_Click"/>
                <Button x:Name="RelaxedButton" Content="?? Relaxed (30 min)" 
                        Style="{StaticResource ModernButton}" Click="RelaxedButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Current Settings Display -->
        <Border Grid.Row="6" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Current Settings:" FontWeight="Bold" Foreground="#050d60" Margin="0,0,0,8"/>
                <TextBlock x:Name="CurrentSettingsTextBlock" Text="Timeout: 15 min, Warning: 1 min" 
                           FontSize="12" Foreground="#333333"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="?? Save" Width="100" Height="40" 
                    Style="{StaticResource SuccessButton}" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="? Cancel" Width="100" Height="40" 
                    Style="{StaticResource ModernButton}" Click="CancelButton_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
