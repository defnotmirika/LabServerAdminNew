<Window x:Class="LabServerAdmin.ShowLearniq"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabServerAdmin"
        mc:Ignorable="d"
        Title="ShowLearniq" Height="450" Width="800"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#050d60">

    <Grid>

        <!-- Overlay -->
        <Grid x:Name="WelcomeOverlay"
          Background="#050d60"
          Opacity="0">

            <!-- Center everything -->
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <!-- Image -->
                <Image x:Name="Logo"
                   Width="120"
                   Height="120"
                   Source="/Images/learniq.png"
                   Opacity="0"/>

                <!-- Spacing -->
                <Rectangle Width="10"/>

                <!-- Text with colored IQ -->
                <StackPanel x:Name="TitleText" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Learn" FontSize="60" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="iq" FontSize="60" FontWeight="Bold" Foreground="#F8B800" Margin="-5,0,0,0"/>
                </StackPanel>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
