<Window x:Class="LabServerAdmin.VoiceEnrollmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎤 Voice Enrollment" Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#050d60">

    <Window.Resources>
        <Style x:Key="EnrollButton" TargetType="Button">
            <Setter Property="Background" Value="#050d60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0a1580"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordButton" TargetType="Button">
            <Setter Property="Background" Value="#28a745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas Width="1100"
                Height="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <TextBlock x:Name="CardTutorialText"
                       Canvas.Left="0"
                       Canvas.Top="8"
                       Width="1100"
                       Text="Voice Enrollment"
                       FontWeight="Bold"
                       FontSize="30"
                       Foreground="White"
                       TextAlignment="Center"/>

            <Border Canvas.Left="270"
                    Canvas.Top="55"
                    Width="560"
                    Height="640"
                    Background="White"
                    CornerRadius="15"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Voice Enrollment"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#050d60"/>
                        <TextBlock x:Name="UsernameLabel"
                                   Text="Instructor: "
                                   FontSize="13"
                                   Foreground="#555555"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Record all sample phrases so the system can recognize your voice."
                                   FontSize="13"
                                   Foreground="#555555"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#050d60"
                            CornerRadius="8"
                            Padding="20,14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="PhraseNumberText"
                                       Text="Phrase 1"
                                       FontSize="12"
                                       Foreground="#f8b800"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="PhraseText"
                                       Text="Lock all computers"
                                       FontSize="18"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Read the phrase above clearly when recording starts."
                                       FontSize="11"
                                       Foreground="#aaaacc"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="WhiteSmoke"
                            CornerRadius="10"
                            Padding="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,10,0,22">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Rectangle x:Name="Wave1" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave2" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave3" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave4" Width="10" Height="20" Fill="Green" Margin="5"/>
                            <Rectangle x:Name="Wave5" Width="10" Height="20" Fill="Green" Margin="5"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,6,0,16">
                        <Grid HorizontalAlignment="Center">
                            <Ellipse x:Name="Glow"
                                     Width="120"
                                     Height="120"
                                     Fill="DeepSkyBlue"
                                     Opacity="0"/>

                            <Button x:Name="MicButton"
                                    Width="80"
                                    Height="80"
                                    Click="MicButton_Click"
                                    Background="#F8B800"
                                    BorderBrush="White"
                                    BorderThickness="2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="{TemplateBinding Background}"
                                                     Stroke="{TemplateBinding BorderBrush}"
                                                     StrokeThickness="2"/>
                                            <TextBlock Text="🎙️"
                                                       FontSize="30"
                                                       Foreground="#050d60"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Ellipse x:Name="RecordingIndicator" Width="12" Height="12" Fill="#cccccc" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RecordingStatusText"
                                           Text="Ready to record"
                                           FontSize="13"
                                           Foreground="#444444"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ProgressBar x:Name="RecordingProgress"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Width="330"
                                         Background="#e9ecef"
                                         Foreground="#28a745"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="ExistingProfileWarning"
                            Grid.Row="4"
                            Background="#fff3cd"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,14"
                            BorderBrush="#ffc107"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock Text="⚠️ You already have an enrolled voice profile. Recording new samples will replace it."
                                   FontSize="12"
                                   Foreground="#856404"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <WrapPanel x:Name="SampleStatusPanel"
                                   HorizontalAlignment="Center"
                                   Width="500"
                                   ItemHeight="24"
                                   ItemWidth="120"/>
                        <TextBlock x:Name="SampleTimerStatusText"
                                   Text="Timer: Not started"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="RecordButton"
                                Content="Start Recording"
                                Style="{StaticResource RecordButton}"
                                Click="RecordButton_Click"
                                Width="165"
                                Height="40"/>
                        <Button x:Name="SaveButton"
                                Content="✅ Save Profile"
                                Style="{StaticResource EnrollButton}"
                                Click="SaveButton_Click"
                                Width="155"
                                Height="40"
                                Margin="12,0,0,0"
                                IsEnabled="False"/>
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Style="{StaticResource EnrollButton}"
                                Click="CancelButton_Click"
                                Width="100"
                                Height="40"
                                Margin="12,0,0,0"
                                Background="#6c757d"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TutorialBox"
                    Canvas.Left="0"
                    Canvas.Top="55"
                    Width="220"
                    Height="140"
                    Background="#FFFDE9A9"
                    BorderBrush="#FFB8860B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    Opacity="1"
                    Panel.ZIndex="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TutorialText"
                               Grid.Row="0"
                               Text="This is a voice register button"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevButton"
                                Content="Previous"
                                Width="70"
                                Height="30"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Click="Prev_Click"/>

                        <Button x:Name="NextButton"
                                Content="Next"
                                Width="70"
                                Height="30"
                                HorizontalAlignment="Right"
                                Grid.Column="1"
                                Click="Next_Click"/>
                    </Grid>
                </Grid>
            </Border>

        </Canvas>
    </Grid>
</Window>
