<Window x:Class="LabServerAdmin.VoiceEnrollmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎤 Voice Enrollment" Height="720" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#050d60">

    <Window.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#28a745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#e9ecef"/>
                                <Setter Property="Foreground" Value="#aaaaaa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#050d60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0a1580"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#e9ecef"/>
                                <Setter Property="Foreground" Value="#aaaaaa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#cccccc"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#f2f2f2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- HEADER -->
        <Border VerticalAlignment="Top" Background="#050d60" Height="70">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <Border Width="40" Height="40" CornerRadius="20" Background="#F8B800" VerticalAlignment="Center">
                    <TextBlock Text="🎙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Voice Enrollment" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="UsernameLabel" Text="Professor: " FontSize="12" Foreground="#8888aa"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN WHITE CARD -->
        <Border Margin="16,78,16,16" Background="White" CornerRadius="12">
            <Grid Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Existing profile warning -->
                <Border x:Name="ExistingProfileWarning"
                        Grid.Row="0"
                        Background="#fff8e1"
                        CornerRadius="8"
                        Padding="12,9"
                        Margin="0,0,0,14"
                        BorderBrush="#ffe082"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock Text="⚠️  You already have a voice profile. Recording new samples will replace it."
                               FontSize="12" Foreground="#7a5800" TextWrapping="Wrap"/>
                </Border>

                <!-- Row 1: Phrase box -->
                <Border Grid.Row="1" Background="#050d60" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="PhraseNumberText" Text="Phrase 1 of 10"
                                   FontSize="11" Foreground="#F8B800" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PhraseText" Text="Lock all computers"
                                   FontSize="20" Foreground="White" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,4"/>
                        <TextBlock Text="Read this phrase clearly when recording starts."
                                   FontSize="11" Foreground="#8888aa"/>
                    </StackPanel>
                </Border>

                <!-- Row 2: Wave visualizer — fixed height so bars are always visible -->
                <Border Grid.Row="2" Background="#f6f7f9" CornerRadius="10"
                        Margin="0,0,0,14" Height="60">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Rectangle x:Name="Wave1" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave2" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave3" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave4" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave5" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave6" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave7" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave8" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                        <Rectangle x:Name="Wave9" Width="7" Height="22" Fill="#cccccc" RadiusX="3" RadiusY="3" Margin="5,0"/>
                    </StackPanel>
                </Border>

                <!-- Row 3: Mic button + status + progress -->
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Grid HorizontalAlignment="Center">
                        <Ellipse x:Name="Glow" Width="96" Height="96" Fill="#F8B800" Opacity="0"/>
                        <Button x:Name="MicButton" Width="68" Height="68"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="MicButton_Click"
                                Background="#F8B800" BorderBrush="White" BorderThickness="2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Fill="{TemplateBinding Background}"
                                                 Stroke="{TemplateBinding BorderBrush}"
                                                 StrokeThickness="2"/>
                                        <TextBlock Text="🎙️" FontSize="26"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,8">
                        <Ellipse x:Name="RecordingIndicator" Width="10" Height="10"
                                 Fill="#cccccc" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecordingStatusText" Text="Ready to record"
                                   FontSize="13" Foreground="#444444"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ProgressBar x:Name="RecordingProgress"
                                 Height="6" Minimum="0" Maximum="100" Value="0"
                                 Width="380" Background="#e9ecef" Foreground="#28a745"/>
                </StackPanel>

                <!-- Row 4: Divider -->
                <Separator Grid.Row="4" Background="#eeeeee" Margin="0,0,0,12"/>

                <!-- Row 5: Section label -->
                <TextBlock Grid.Row="5" Text="SAMPLE PROGRESS"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#999999" Margin="0,0,0,8"/>

                <!-- Row 6: Sample pills -->
                <WrapPanel x:Name="SampleStatusPanel"
                           Grid.Row="6"
                           HorizontalAlignment="Left"
                           ItemHeight="28"
                           Margin="0,0,0,4"/>

                <!-- Row 7: Timer text -->
                <TextBlock x:Name="SampleTimerStatusText"
                           Grid.Row="7"
                           Text="Timer: Not started"
                           FontSize="11" Foreground="#aaaaaa"
                           Margin="0,4,0,0"/>

                <!-- Row 8: Spacer -->
                <Grid Grid.Row="8"/>

                <!-- Row 9: Action buttons -->
                <Grid Grid.Row="9" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RecordButton"
                            Grid.Column="0"
                            Content="🎤  Start Recording"
                            Style="{StaticResource DarkButton}"
                            Height="40"
                            Click="RecordButton_Click"/>

                    <Button x:Name="SaveButton"
                            Grid.Column="2"
                            Content="✅  Save Profile"
                            Style="{StaticResource PrimaryButton}"
                            Height="40"
                            IsEnabled="False"
                            Click="SaveButton_Click"/>

                    <Button x:Name="CancelButton"
                            Grid.Column="4"
                            Content="Cancel"
                            Style="{StaticResource GhostButton}"
                            Height="40"
                            Click="CancelButton_Click"/>
                </Grid>

            </Grid>
        </Border>

        <!-- TUTORIAL BOX -->
        <Border x:Name="TutorialBox"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        Margin="24,0,0,24"
        Width="230"
        Background="#1a237e"
        BorderBrush="#3949ab"
        BorderThickness="1"
        CornerRadius="10"
        Padding="14,12"
        Panel.ZIndex="10">
            <StackPanel>
                <!-- Header row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Background="#F8B800" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                        <TextBlock x:Name="TutorialStepBadge" Text="Step 1 of 3"
                           FontSize="10" FontWeight="SemiBold" Foreground="#1a237e"/>
                    </Border>
                    <TextBlock Text="Quick Guide" FontSize="11"
                       FontWeight="SemiBold" Foreground="#7986cb"/>
                </StackPanel>

                <!-- Body -->
                <TextBlock x:Name="TutorialText"
                   Text="This is the voice register button. Click it to begin recording your voice samples."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="White"
                   LineHeight="18"
                   Margin="0,0,0,12"/>

                <!-- Nav buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrevButton"
                    Content="← Prev" Width="64" Height="26" FontSize="11"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="Prev_Click"/>
                    <Button x:Name="NextButton"
                    Content="Next →" Width="64" Height="26" FontSize="11"
                    HorizontalAlignment="Right"
                    Grid.Column="1"
                    Click="Next_Click"/>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>
