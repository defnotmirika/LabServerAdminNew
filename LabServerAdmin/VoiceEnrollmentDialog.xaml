<Window x:Class="LabServerAdmin.VoiceEnrollmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎤 Voice Enrollment" Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f4f6fb">

    <Window.Resources>
        <Style x:Key="EnrollButton" TargetType="Button">
            <Setter Property="Background" Value="#050d60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0a1580"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordButton" TargetType="Button">
            <Setter Property="Background" Value="#28a745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#218838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#cccccc"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Voice Enrollment" FontSize="22" FontWeight="Bold" Foreground="#050d60"/>
            <TextBlock x:Name="UsernameLabel" Text="Professor: " FontSize="13" Foreground="#555555" Margin="0,4,0,0"/>
            <TextBlock Text="Record 3 sample phrases so the system can recognize your voice."
                       FontSize="13" Foreground="#555555" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Current Phrase -->
        <Border Grid.Row="1" Background="#050d60" CornerRadius="8" Padding="20,14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="PhraseNumberText" Text="Phrase 1 of 3"
                           FontSize="12" Foreground="#f8b800" FontWeight="SemiBold"/>
                <TextBlock x:Name="PhraseText" Text="Lock all computers"
                           FontSize="18" Foreground="White" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="Read the phrase above clearly when recording starts."
                           FontSize="11" Foreground="#aaaacc" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Recording Status -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                BorderBrush="#e0e0e0" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse x:Name="RecordingIndicator" Width="12" Height="12" Fill="#cccccc" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RecordingStatusText" Text="Ready to record"
                               FontSize="13" Foreground="#444444" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ProgressBar x:Name="RecordingProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                             Background="#e9ecef" Foreground="#28a745"/>
            </StackPanel>
        </Border>

        <!-- Sample Status (3 checkmarks) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Center">
            <Border x:Name="Sample1Border" Background="#e9ecef" CornerRadius="20" Padding="12,6" Margin="6,0">
                <TextBlock x:Name="Sample1Text" Text="① Not recorded" FontSize="12" Foreground="#888888"/>
            </Border>
            <Border x:Name="Sample2Border" Background="#e9ecef" CornerRadius="20" Padding="12,6" Margin="6,0">
                <TextBlock x:Name="Sample2Text" Text="② Not recorded" FontSize="12" Foreground="#888888"/>
            </Border>
            <Border x:Name="Sample3Border" Background="#e9ecef" CornerRadius="20" Padding="12,6" Margin="6,0">
                <TextBlock x:Name="Sample3Text" Text="③ Not recorded" FontSize="12" Foreground="#888888"/>
            </Border>
        </StackPanel>

        <!-- Existing Profile Warning -->
        <Border x:Name="ExistingProfileWarning" Grid.Row="4" Background="#fff3cd"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                BorderBrush="#ffc107" BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock Text="⚠️ You already have an enrolled voice profile. Recording new samples will replace it."
                       FontSize="12" Foreground="#856404" TextWrapping="Wrap"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="RecordButton" Content="Start Recording" Style="{StaticResource RecordButton}"
                    Click="RecordButton_Click" Width="160"/>
            <Button x:Name="SaveButton" Content="✅ Save Profile" Style="{StaticResource EnrollButton}"
                    Click="SaveButton_Click" Width="140" Margin="12,0,0,0" IsEnabled="False"/>
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource EnrollButton}"
                    Click="CancelButton_Click" Width="90" Margin="12,0,0,0"
                    Background="#6c757d"/>
        </StackPanel>
    </Grid>
</Window>
