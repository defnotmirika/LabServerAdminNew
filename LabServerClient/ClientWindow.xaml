<Window x:Class="LabServerClient.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lab Server Client"
        Height="420"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#050d60">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#050d60" />
        <SolidColorBrush x:Key="AccentBrush" Color="#f8b800" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffd24d" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e0aa00" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusConnected" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="StatusDisconnected" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E53935" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="White"
                CornerRadius="12"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Client Configuration"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Server IP" FontSize="13" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBox x:Name="ServerIpTextBox"
                             Height="28"
                             Margin="0,4,0,0"
                             LostFocus="ServerIpTextBox_LostFocus" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="PC Name" FontSize="13" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBox x:Name="PcNameTextBox"
                             Height="28"
                             Margin="0,4,0,0"
                             LostFocus="PcNameTextBox_LostFocus" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button x:Name="SaveButton"
                            Content="Save Configuration"
                            Width="170"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveButton_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                    <Button x:Name="LogoutButton"
                            Content="Logout"
                            Width="160"
                            Style="{StaticResource PrimaryButton}"
                            Background="#f0625f"
                            Foreground="White"
                            Click="LogoutButton_Click" />
                </StackPanel>

                <Border Background="#FAFAFA"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,16,0,0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock x:Name="StatusText"
                                   Text="Disconnected"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource StatusDisconnected}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
