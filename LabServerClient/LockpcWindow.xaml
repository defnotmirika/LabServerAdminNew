<Window x:Class="LabServerClient.LockpcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#2C3E50"
        Title="Kiosk Mode">
    <Grid Background="#2C3E50">
        <Border Width="600"
            Padding="40"
            CornerRadius="15"
            Background="White"
            BorderBrush="#3498DB"
            BorderThickness="3"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,30">
                    <Image Source="/Images/trinity.png" 
                           Width="100" 
                           Height="100" 
                           Margin="10"
                           Stretch="Uniform"/>
                    <Image Source="/Images/learniq.png" 
                           Width="100" 
                           Height="100" 
                           Margin="10"
                           Stretch="Uniform"/>
                </StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                          Text="Computer Locked" 
                          FontSize="36" 
                          FontWeight="Bold" 
                          HorizontalAlignment="Center"
                          Foreground="#2C3E50"
                          Margin="0,0,0,15"/>
                <TextBlock x:Name="MessageTextBlock"
                          Text="This computer is currently locked by the administrator." 
                          FontSize="18" 
                          HorizontalAlignment="Center"
                          Foreground="#7F8C8D"
                          TextWrapping="Wrap"
                          TextAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock x:Name="SubMessageTextBlock"
                          Text="Please wait for unlock..." 
                          FontSize="16" 
                          HorizontalAlignment="Center"
                          Foreground="#95A5A6"
                          FontStyle="Italic"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
