<Window x:Class="LabServerClient.LockpcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#050d60"
        Title="Kiosk Mode">
    <Grid Background="#050d60">
        <Border Width="700"
            Padding="50"
            CornerRadius="16"
            Background="White"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" 
                                  ShadowDepth="0" 
                                  Opacity="0.3" 
                                  Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <!-- Header Section with Blue Background -->
                <Border Background="#050d60"
                        CornerRadius="12"
                        Padding="30,25"
                        Margin="0,0,0,35">
                    <StackPanel>
                        <!-- Logo Section -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,20">
                            <Grid Width="90" Height="90" Margin="0,0,15,0">
                                <Border Background="White" 
                                       CornerRadius="45"
                                       Opacity="0.15"/>
                                <Image Source="/trinity2.png" Width="60" Height="60"/>
                            </Grid>
                            <Grid Width="90" Height="90" Margin="0,0,15,0">
                                <Border Background="White" 
                                       CornerRadius="45"
                                       Opacity="0.15"/>
                                <Image Source="/Images/learniq.png" Width="60" Height="60"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="TitleTextBlock"
                                  Text="Computer Locked" 
                                  FontSize="38" 
                                  FontWeight="Bold" 
                                  HorizontalAlignment="Center"
                                  Foreground="White"
                                  Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Message Section -->
                <StackPanel Margin="20,0,20,0">
                    <TextBlock x:Name="MessageTextBlock"
                              Text="This computer is currently locked by the administrator." 
                              FontSize="20" 
                              HorizontalAlignment="Center"
                              Foreground="#050d60"
                              FontWeight="SemiBold"
                              TextWrapping="Wrap"
                              TextAlignment="Center"
                              Margin="0,0,0,15"/>
                    <TextBlock x:Name="SubMessageTextBlock"
                              Text="Please wait for unlock..." 
                              FontSize="17" 
                              HorizontalAlignment="Center"
                              Foreground="#7F8C8D"
                              TextWrapping="Wrap"
                              TextAlignment="Center"
                              Margin="0,0,0,20"/>

                    <!-- Info Box -->
                    <Border Background="#F8F9FA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20,15"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center">
                            <TextBlock Text="??" 
                                      FontSize="20" 
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="For assistance, please contact your administrator" 
                                      FontSize="14" 
                                      Foreground="#666666"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
