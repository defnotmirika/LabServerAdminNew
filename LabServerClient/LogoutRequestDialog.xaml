<Window x:Class="LabServerClient.LogoutRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Request Logout"
        WindowStartupLocation="CenterScreen"
        Width="500"
        Height="auto"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="LineHeight" Value="1.5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <StackPanel Margin="30" VerticalAlignment="Center">

            <!-- Icon/Title -->
            <TextBlock Text="Request Logout"
                     FontSize="24"
                     FontWeight="Bold"
                     Margin="0,0,0,20"
                     Foreground="#E74C3C"/>

            <!-- Message -->
            <TextBlock Text="Your logout request must be approved by the instructor."
                     FontSize="14"
                     Margin="0,0,0,15"
                     TextWrapping="Wrap"
                     FontWeight="SemiBold"/>

            <!-- Additional Info -->
            <Border Background="#FFF3CD"
                    BorderBrush="#FFC107"
                    BorderThickness="1"
                    Padding="15"
                    Margin="0,0,0,20"
                    CornerRadius="5">
                <TextBlock TextWrapping="Wrap"
                          FontSize="13">
                    <Run Text="You are currently in an active lab session."/>
                    <LineBreak/>
                    <LineBreak/>
                    <Run Text="To log out early, you must request approval from your instructor. Your request will be reviewed and you will be notified when approved."/>
                </TextBlock>
            </Border>

            <!-- Question -->
            <TextBlock Text="Do you want to send a logout request to the instructor?"
                     FontSize="14"
                     Margin="0,0,0,20"
                     TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Grid HorizontalAlignment="Right" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ConfirmButton"
                       Content="Confirm Request"
                       Grid.Column="0"
                       Style="{StaticResource PrimaryButton}"
                       Click="ConfirmButton_Click"/>

                <Button x:Name="CancelButton"
                       Content="Cancel"
                       Grid.Column="1"
                       Style="{StaticResource SecondaryButton}"
                       Click="CancelButton_Click"/>
            </Grid>

            <!-- Info text -->
            <TextBlock Text="You will remain logged in until the instructor approves your request."
                     FontSize="11"
                     Foreground="#7F8C8D"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</Window>
