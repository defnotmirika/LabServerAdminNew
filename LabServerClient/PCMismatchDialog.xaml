<Window x:Class="LabServerClient.PCMismatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Mismatch"
        WindowStartupLocation="CenterScreen"
        Width="500"
        Height="auto"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#050d60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="LineHeight" Value="1.5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <StackPanel Margin="30" VerticalAlignment="Center">

            <!-- Icon/Title -->
            <TextBlock Text="PC Mismatch Detected!"
                     FontSize="24"
                     FontWeight="Bold"
                     Margin="0,0,0,20"
                     Foreground="#E74C3C"/>

            <!-- Message -->
            <TextBlock Text="You are not on your assigned PC. Your assigned PC is:"
                     FontSize="14"
                     Margin="0,0,0,10"/>

            <!-- Assigned PC Name -->
            <TextBlock x:Name="AssignedPcNameTextBlock"
                     Text=""
                     FontSize="16"
                     FontWeight="Bold"
                     Background="#ECF0F1"
                     Padding="10"
                     Margin="0,0,0,15"
                     TextAlignment="Center"
                     Foreground="#34495E"/>

            <!-- Current PC Name -->
            <TextBlock Text="Current PC:"
                     FontSize="12"
                     Foreground="#7F8C8D"
                     Margin="0,0,0,5"/>

            <TextBlock x:Name="CurrentPcNameTextBlock"
                     Text=""
                     FontSize="12"
                     Background="#E8F8F5"
                     Padding="8"
                     Margin="0,0,0,20"
                     Foreground="#34495E"/>

            <!-- Question -->
            <TextBlock Text="Do you want to send a request to the admin to allow this login?"
                     FontSize="14"
                     Margin="0,0,0,20"
                     TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Grid HorizontalAlignment="Right" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="YesButton"
                       Content="Yes, Send Request"
                       Grid.Column="0"
                       Style="{StaticResource PrimaryButton}"
                       Click="YesButton_Click"/>

                <Button x:Name="NoButton"
                       Content="No, Cancel"
                       Grid.Column="1"
                       Style="{StaticResource SecondaryButton}"
                       Click="NoButton_Click"/>
            </Grid>

            <!-- Info text -->
            <TextBlock Text="Sending a request will notify the administrator about your login attempt from this PC."
                     FontSize="11"
                     Foreground="#7F8C8D"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</Window>
