<Window x:Class="LabServerClient.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lab Session"
        Height="520"
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid>
        <!-- Main Card -->
        <Border Background="White"
                CornerRadius="12"
                Padding="25"
                Margin="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- Session Info -->
                    <RowDefinition Height="Auto"/>
                    <!-- Current Command -->
                    <RowDefinition Height="Auto"/>
                    <!-- Storage Button -->
                    <RowDefinition Height="Auto"/>
                    <!-- Logout -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Lab Session"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Active student session"
                               FontSize="12"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Session Info -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock x:Name="UsernameText"
                               Text=""
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#050d60"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Remaining time"
                               FontSize="13"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="TimeRemainingText"
                               Text="00:00:00"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#2D6CDF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                </StackPanel>

                <!-- Current Command -->
                <Border Grid.Row="2"
                        Background="#FAFAFA"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,20,0,0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">

                    <StackPanel>
                        <TextBlock Text="Current Command"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <TextBlock x:Name="CurrentCommandText"
                                   Text="None"
                                   FontSize="14"
                                   FontStyle="Italic"
                                   Foreground="#555"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Storage Button -->
                <Button Grid.Row="3"
                        x:Name="StorageButton"
                        Content="My Storage"
                        Height="38"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="0,18,0,0"
                        Background="#050d60"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="StorageButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Logout Button -->
                <Button Grid.Row="4"
                        x:Name="LogoutButton"
                        Content="Logout"
                        Height="42"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="0,25,0,0"
                        Background="#E53935"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LogoutButton_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>
        </Border>
    </Grid>
</Window>
