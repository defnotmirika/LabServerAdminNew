<Window x:Class="LabServerClient.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="My Storage"
        Height="650"
        Width="950" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#050d60" />
        <SolidColorBrush x:Key="AccentBrush" Color="#f8b800" />

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffd24d" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#E8EAF0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D4D7E0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridActionButton" TargetType="Button">
            <Setter Property="Background" Value="#F0F2F5" />
            <Setter Property="Foreground" Value="#050d60" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DDE1E7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridDeleteButton" TargetType="Button" BasedOn="{StaticResource GridActionButton}">
            <Setter Property="Foreground" Value="#E53935" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBEE" />
                    <Setter Property="Foreground" Value="#C62828" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Border Background="White" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="16,16,0,0" Padding="30,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#1a237e" Width="50" Height="50" CornerRadius="12" Margin="0,0,15,0">
                            <TextBlock Text="📁" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="My Storage" FontSize="24" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Manage your files and documents" FontSize="12" Foreground="#B0C4DE"/>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#1a237e" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                            <TextBlock x:Name="OwnerText" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#F8F9FA" Padding="30,15" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📤  Upload Files" Style="{StaticResource AccentButton}" Click="UploadButton_Click" Margin="0,0,10,0"/>
                            <Button Content="🔄" Style="{StaticResource IconButton}" Click="RefreshButton_Click" ToolTip="Refresh List"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="💡 Drag and drop files here to upload" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="FilesGrid" 
                          Grid.Row="2" 
                          Margin="20"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          ItemsSource="{Binding Files}" 
                          IsReadOnly="True" 
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="White">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#EEE"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="45"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="80"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="100"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding UploadDate, StringFormat={}{0:MMM dd\, yyyy}}" Width="120"/>

                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="📥" 
                                                Style="{StaticResource GridActionButton}" 
                                                ToolTip="Download"
                                                Click="DownloadButton_Click" 
                                                Tag="{Binding}"/>

                                        <Button Content="✏️" 
                                                Style="{StaticResource GridActionButton}" 
                                                ToolTip="Rename"
                                                Click="RenameButton_Click" 
                                                Tag="{Binding}"/>

                                        <Button Content="🗑️" 
                                                Style="{StaticResource GridDeleteButton}" 
                                                ToolTip="Delete"
                                                Click="DeleteButton_Click" 
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>